{
  "info": {
    "name": "Restful Booker API - Rahul Karamchund",
    "description": "Tests for each Restful Booker endpoint. Run the folders in order. API docs: https://restful-booker.herokuapp.com/apidoc/index.html",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Health",
      "item": [
        {
          "name": "GET /ping - health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201 Created\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Body is Created\", () => pm.expect(pm.response.text()).to.eql(\"Created\"));",
                  "pm.test(\"Response time < 3000ms\", () => pm.expect(pm.response.responseTime).to.be.below(3000));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ping",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ping"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "02 Auth",
      "item": [
        {
          "name": "POST /auth - valid credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Response has token\", () => pm.expect(json).to.have.property(\"token\"));",
                  "pm.test(\"Token is a non-empty string\", () => pm.expect(json.token).to.be.a(\"string\").and.not.empty);",
                  "pm.environment.set(\"token\", json.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          }
        },
        {
          "name": "POST /auth - invalid credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 (API quirk)\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Body explains bad credentials\", () => {",
                  "  pm.expect(json).to.have.property(\"reason\");",
                  "  pm.expect(json.reason).to.eql(\"Bad credentials\");",
                  "});",
                  "pm.test(\"No token issued\", () => pm.expect(json.token).to.be.undefined);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"wrong-password\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "03 Bookings",
      "item": [
        {
          "name": "POST /booking - create",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Response has bookingid\", () => pm.expect(json).to.have.property(\"bookingid\"));",
                  "pm.test(\"Booking mirrors request fields\", () => {",
                  "  pm.expect(json.booking.firstname).to.eql(pm.environment.get(\"firstname\"));",
                  "  pm.expect(json.booking.lastname).to.eql(pm.environment.get(\"lastname\"));",
                  "  pm.expect(json.booking.totalprice).to.eql(150);",
                  "  pm.expect(json.booking.depositpaid).to.eql(true);",
                  "  pm.expect(json.booking.bookingdates.checkin).to.eql(pm.environment.get(\"checkin\"));",
                  "  pm.expect(json.booking.bookingdates.checkout).to.eql(pm.environment.get(\"checkout\"));",
                  "  pm.expect(json.booking.additionalneeds).to.eql(\"Breakfast\");",
                  "});",
                  "pm.environment.set(\"bookingId\", json.bookingid);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"{{firstname}}\",\n  \"lastname\": \"{{lastname}}\",\n  \"totalprice\": 150,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"{{checkin}}\",\n    \"checkout\": \"{{checkout}}\"\n  },\n  \"additionalneeds\": \"Breakfast\"\n}"
            }
          }
        },
        {
          "name": "GET /booking - list all ids",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Body is an array\", () => pm.expect(json).to.be.an(\"array\"));",
                  "pm.test(\"Array items have bookingid\", () => {",
                  "  pm.expect(json.length).to.be.above(0);",
                  "  pm.expect(json[0]).to.have.property(\"bookingid\");",
                  "});",
                  "pm.test(\"Created booking id is present\", () => {",
                  "  const id = Number(pm.environment.get(\"bookingId\"));",
                  "  pm.expect(json.some((b) => b.bookingid === id)).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            }
          }
        },
        {
          "name": "GET /booking - filter by name",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Filtered list includes our booking\", () => {",
                  "  const id = Number(pm.environment.get(\"bookingId\"));",
                  "  pm.expect(json.some((b) => b.bookingid === id)).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/booking?firstname={{firstname}}&lastname={{lastname}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ],
              "query": [
                {
                  "key": "firstname",
                  "value": "{{firstname}}"
                },
                {
                  "key": "lastname",
                  "value": "{{lastname}}"
                }
              ]
            }
          }
        },
        {
          "name": "GET /booking - filter by date",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Body is an array\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/booking?checkin={{checkin}}&checkout={{checkout}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ],
              "query": [
                {
                  "key": "checkin",
                  "value": "{{checkin}}"
                },
                {
                  "key": "checkout",
                  "value": "{{checkout}}"
                }
              ]
            }
          }
        },
        {
          "name": "GET /booking/:id - fetch created",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Schema has expected keys\", () => {",
                  "  [\"firstname\",\"lastname\",\"totalprice\",\"depositpaid\",\"bookingdates\"].forEach((k) => pm.expect(json).to.have.property(k));",
                  "});",
                  "pm.test(\"Values match what we created\", () => {",
                  "  pm.expect(json.firstname).to.eql(pm.environment.get(\"firstname\"));",
                  "  pm.expect(json.lastname).to.eql(pm.environment.get(\"lastname\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            }
          }
        },
        {
          "name": "PUT /booking/:id - full update",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Firstname updated\", () => pm.expect(json.firstname).to.eql(\"RahulUpdated\"));",
                  "pm.test(\"Total price updated\", () => pm.expect(json.totalprice).to.eql(200));",
                  "pm.test(\"Deposit paid updated\", () => pm.expect(json.depositpaid).to.eql(false));",
                  "pm.environment.set(\"firstname\", \"RahulUpdated\");"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "token={{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"RahulUpdated\",\n  \"lastname\": \"Karamchund\",\n  \"totalprice\": 200,\n  \"depositpaid\": false,\n  \"bookingdates\": {\n    \"checkin\": \"{{checkin}}\",\n    \"checkout\": \"{{checkout}}\"\n  },\n  \"additionalneeds\": \"Late checkout\"\n}"
            }
          }
        },
        {
          "name": "PATCH /booking/:id - partial update",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Patched field updated\", () => pm.expect(json.additionalneeds).to.eql(\"Quiet room\"));",
                  "pm.test(\"Other fields preserved\", () => pm.expect(json.lastname).to.eql(\"Karamchund\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "token={{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"additionalneeds\": \"Quiet room\"\n}"
            }
          }
        },
        {
          "name": "DELETE /booking/:id - delete",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201 Created (API quirk for delete)\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Body is Created\", () => pm.expect(pm.response.text()).to.eql(\"Created\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Cookie",
                "value": "token={{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            }
          }
        },
        {
          "name": "GET /booking/:id - confirm deleted",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404 after delete\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "04 Negative cases",
      "item": [
        {
          "name": "GET /booking/:id - unknown id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/99999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "99999999"
              ]
            }
          }
        },
        {
          "name": "PUT /booking/:id - no auth token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 403 Forbidden\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "1"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"No\",\n  \"lastname\": \"Auth\",\n  \"totalprice\": 1,\n  \"depositpaid\": false,\n  \"bookingdates\": {\n    \"checkin\": \"2027-01-01\",\n    \"checkout\": \"2027-01-02\"\n  }\n}"
            }
          }
        },
        {
          "name": "POST /booking - malformed payload",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status indicates failure (500 is a known quirk)\", () => {",
                  "  pm.expect([400, 500]).to.include(pm.response.code);",
                  "});",
                  "pm.test(\"Does not return a bookingid\", () => {",
                  "  try {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.bookingid).to.be.undefined;",
                  "  } catch (e) {",
                  "    // non-JSON body is also acceptable for a failure response",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 500]);",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"OnlyFirstName\"\n}"
            }
          }
        },
        {
          "name": "DELETE /booking/:id - no auth",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 403 Forbidden\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/booking/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "1"
              ]
            }
          }
        }
      ]
    }
  ]
}